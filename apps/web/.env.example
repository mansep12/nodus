# Written by `bun run --filter @nodus/e2e deploy`, which deploys a test token
# and the Nodus contract to testnet.
NEXT_PUBLIC_NODUS_CONTRACT=
NEXT_PUBLIC_TOKEN_CONTRACT=
NODUS_DEPLOY_LEDGER=
# Secret key of the test token's issuer; enables the "get test USDC" button.
TOKEN_ISSUER_SECRET=

# API key for OpenZeppelin Channels on testnet, which submits and pays for
# every transaction. Get one with: curl https://channels.openzeppelin.com/testnet/gen
OZ_CHANNELS_API_KEY=

# Postgres connection string (Supabase). Without it the app uses an embedded
# Postgres stored in .data/, which is enough for local development.
DATABASE_URL=

# Set to 1 to replace device passkeys with keys kept in the browser's storage.
# Only for automated testing: they are not protected by the device.
# `bun run deploy:sandbox && bun run dev:sandbox` runs a second instance of the
# app that way on port 3001, with its own contract and database.
NEXT_PUBLIC_SOFTWARE_PASSKEYS=
