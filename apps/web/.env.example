# Written by `bun run deploy:testnet`, which deploys a test token, the Nodus
# contract and the allowlist policy to testnet.
NEXT_PUBLIC_NODUS_CONTRACT=
NEXT_PUBLIC_TOKEN_CONTRACT=
NEXT_PUBLIC_ALLOWLIST_POLICY=
NODUS_DEPLOY_LEDGER=
# Secret key of the test token's issuer; enables the "get test USDC" button.
TOKEN_ISSUER_SECRET=

# API key for OpenZeppelin Channels on testnet, which submits and pays for
# every transaction. Get one with: curl https://channels.openzeppelin.com/testnet/gen
OZ_CHANNELS_API_KEY=

# Postgres connection string (Supabase). Without it the app uses an embedded
# Postgres stored in .data/, which is enough for local development.
DATABASE_URL=

# Signs the session cookies. Required in production; in development a key is
# kept under .data/ when this is empty. Any long random string will do:
#   openssl rand -base64 32
NODUS_SESSION_SECRET=

# Protects /api/sync, the maintenance a scheduler calls (see vercel.json).
# Vercel sends it as a bearer token when it is set.
CRON_SECRET=

# Web Push (notifications when something waits for a signature). Generate with:
#   bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@example.com
# The same public key, for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Where the app is published, for absolute links in shared cards.
NEXT_PUBLIC_APP_URL=

# Set to 1 to replace device passkeys with keys kept in the browser's storage.
# Only for automated testing: they are not protected by the device, and the
# app ignores it in production.
# `bun run deploy:sandbox && bun run dev:sandbox` runs a second instance of the
# app that way on port 3001, with its own contract and database.
NEXT_PUBLIC_SOFTWARE_PASSKEYS=
